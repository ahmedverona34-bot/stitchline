{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stitchline",
  "version": "1.0.4",
  "identifier": "com.stitchline.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Stitchline",
    "shortDescription": "Stitchline pattern sewing",
    "longDescription": "Stitchline: open drawings, set up stitches and laser cuts, and save SLW machine files.",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": { "icons/project.ico": "project.ico" },
    "fileAssociations": [
      {
        "ext": ["stitchline"],
        "name": "Stitchline.Project",
        "description": "Stitchline project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFNDg5MDJCMDIxRTFCNEMKUldSTUd4NENLNUJJTHJ2bHFRL0o1VDFqS3NySER3eStzMnNBdmZFZFJwdSt6RHdSbGdCaXJQdkkK",
      "endpoints": [
        "https://github.com/ahmedverona34-bot/stitchline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
